#!/bin/sh
# Build a self-contained bundle that runs on a machine with no Python, no Node,
# no pip, no uv and no network.
#
# The bundle keeps this repository's four-environment layout intact, because that
# separation is a privacy boundary and not an implementation detail: each worker
# keeps its own locked dependency set, and the versions come from the committed
# uv.lock files, so the supply chain the reports cite is the one that ships.
#
# Instead of virtualenvs, each `.venv/bin/python` becomes a small shell shim that
# resolves the bundle root from its own location and execs a bundled interpreter
# with the matching vendored packages on PYTHONPATH. Nothing hard-codes an
# absolute path, so the tree runs wherever it is extracted.
#
# Requires (on the BUILD machine only): uv, npm, network access, ~15 GB free disk.
# Build on the oldest target distribution you must support; the bundled wheels are
# glibc- and architecture-specific.
#
# Cross-building: set TARGET_ARCH (e.g. x86_64) to build for a different CPU
# architecture than the build machine. uv then downloads the interpreter and
# wheels for the target without executing them, so the self-check is skipped and
# must be run on a target machine (`run.sh --help` and `scripts/verify`).
# TARGET_GLIBC (default 2.35 = Ubuntu 22.04) picks the manylinux tag.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
OUT=${1:-"$ROOT/var/offline-bundle"}
HOST_ARCH=$(uname -m)
ARCH=${TARGET_ARCH:-$HOST_ARCH}
TARGET_GLIBC=${TARGET_GLIBC:-2.35}
CROSS=0
[ "$ARCH" != "$HOST_ARCH" ] && CROSS=1
STAGE="$OUT/synthetic-table-studio-offline-linux-$ARCH"

PY311_TAG=3.11
PY312_TAG=3.12

echo "==> staging into $STAGE"
if [ -e "$STAGE" ]; then
    rm -rf "$STAGE" || { echo "cannot remove the previous stage $STAGE; move it away first" >&2; exit 1; }
fi
mkdir -p "$STAGE"

if [ "${SKIP_WEB_BUILD:-0}" = 1 ] && [ -f "$ROOT/web/dist/index.html" ]; then
    echo "==> using the existing web build in web/dist (SKIP_WEB_BUILD=1)"
else
    echo "==> building the web interface (build-time only; the bundle ships the output)"
    npm --prefix "$ROOT/web" ci
    npm --prefix "$ROOT/web" run build
fi
mkdir -p "$STAGE/web"
# Source maps stay out of the bundle (copied selectively rather than deleted afterwards).
tar -C "$ROOT/web" --exclude='*.map' -cf - dist | tar -C "$STAGE/web" -xf -

echo "==> copying application sources"
for item in app/src scripts probes/results benchmarks/result-schema.json \
            benchmarks/sample-column-map.example.json \
            README.md CHANGELOG.md PROGRAM_REPORT.md LICENSE; do
    mkdir -p "$STAGE/$(dirname "$item")"
    tar -C "$ROOT" --exclude='__pycache__' -cf - "$item" | tar -C "$STAGE" -xf -
done
for worker in argn dpmm eval; do
    tar -C "$ROOT" --exclude='__pycache__' -cf - "workers/$worker/src" | tar -C "$STAGE" -xf -
done

echo "==> fetching relocatable CPython $PY311_TAG and $PY312_TAG"
mkdir -p "$STAGE/python"
# The interpreter archives contain hard links, which some filesystems (network or
# shared mounts) refuse, so unpack into a scratch dir and copy the tree over.
PYTMP=$(mktemp -d "${TMPDIR:-/tmp}/sts-python.XXXXXX")
if [ "$CROSS" = 1 ]; then
    echo "    cross-build: host $HOST_ARCH -> target $ARCH (glibc $TARGET_GLIBC)"
    uv python install --install-dir "$PYTMP" \
        "cpython-$PY311_TAG-linux-$ARCH-gnu" "cpython-$PY312_TAG-linux-$ARCH-gnu"
else
    uv python install --install-dir "$PYTMP" "$PY311_TAG" "$PY312_TAG"
fi
# share/terminfo has entries differing only by case, which a case-insensitive
# staging filesystem cannot hold; the interpreter does not need it (nor man pages).
for dir in "$PYTMP"/cpython-*.*.*-*; do   # versioned dirs only, not uv's minor-version links
    tar -C "$PYTMP" --exclude='share/terminfo' --exclude='share/man' -cf - "$(basename "$dir")" \
        | tar -C "$STAGE/python" -xf -
done
rm -rf "$PYTMP"
PY311=$(echo "$STAGE"/python/cpython-$PY311_TAG.*/bin/python$PY311_TAG)
PY312=$(echo "$STAGE"/python/cpython-$PY312_TAG.*/bin/python$PY312_TAG)
[ -f "$PY311" ] && [ -f "$PY312" ] || { echo "interpreter download failed" >&2; exit 1; }

echo "==> vendoring locked dependencies (versions come from uv.lock, not a fresh resolve)"
vendor () { # $1=project dir  $2=vendor name  $3=interpreter  $4=python version
    requirements="$OUT/requirements-$2.txt"
    ( cd "$ROOT/$1" && uv export --frozen --no-hashes --no-dev --no-emit-project -o "$requirements" )
    if [ "$CROSS" = 1 ]; then
        # Resolve for the target without running it: binary wheels only, tagged for
        # the target CPU and the oldest glibc the bundle must support.
        uv pip install --python-version "$4" \
            --python-platform "$ARCH-manylinux_${TARGET_GLIBC%%.*}_${TARGET_GLIBC#*.}" \
            --only-binary :all: --no-compile-bytecode \
            --target "$STAGE/vendor/$2" -r "$requirements"
    else
        uv pip install --python "$3" --target "$STAGE/vendor/$2" -r "$requirements"
    fi
}
vendor app            app  "$PY312" "$PY312_TAG"
vendor workers/argn   argn "$PY311" "$PY311_TAG"
vendor workers/dpmm   dpmm "$PY311" "$PY311_TAG"
vendor workers/eval   eval "$PY311" "$PY311_TAG"

echo "==> writing relocatable interpreter shims"
shim () { # $1=venv bin dir  $2=relative hops to root  $3=vendor name  $4=interpreter
    mkdir -p "$1"
    interpreter=${4#"$STAGE/"}
    cat > "$1/python" <<EOF
#!/bin/sh
# Relocatable stand-in for a virtualenv interpreter: resolves the bundle root from
# its own location, so this tree needs no installation and no fixed path.
here=\$(CDPATH= cd -- "\$(dirname -- "\$0")" && pwd -P)
root=\$(CDPATH= cd -- "\$here$2" && pwd -P)
PYTHONPATH="\$root/vendor/$3\${PYTHONPATH:+:\$PYTHONPATH}"
export PYTHONPATH
exec "\$root/$interpreter" "\$@"
EOF
    chmod +x "$1/python"
    ln -sf python "$1/python3"
}
shim "$STAGE/app/.venv/bin"          "/../../.."    app  "$PY312"
shim "$STAGE/workers/argn/.venv/bin" "/../../../.." argn "$PY311"
shim "$STAGE/workers/dpmm/.venv/bin" "/../../../.." dpmm "$PY311"
shim "$STAGE/workers/eval/.venv/bin" "/../../../.." eval "$PY311"

cat > "$STAGE/run.sh" <<'EOF'
#!/bin/sh
# Start Synthetic Table Studio. No installation, no network, no system Python.
set -e
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
STS_SERVE_VENV=1
export STS_SERVE_VENV
exec "$root/app/.venv/bin/python" "$root/scripts/serve" \
  --workspace "${STS_WORKSPACE:-$root/workspace}" \
  --host "${STS_HOST:-127.0.0.1}" \
  --port "${STS_PORT:-8765}" \
  --skip-web-build "$@"
EOF
chmod +x "$STAGE/run.sh"

if [ "$CROSS" = 1 ]; then
    echo "==> self-check skipped (cross-build); on a $ARCH machine run: $(basename "$STAGE")/run.sh --help"
else
    echo "==> self-check"
    "$STAGE/app/.venv/bin/python" -c "import duckdb, pyarrow, fastapi, pydantic; print('  app   ok')"
    "$STAGE/workers/argn/.venv/bin/python" -c "import torch; print('  argn  ok', torch.__version__)"
    "$STAGE/workers/dpmm/.venv/bin/python" -c "import numpy, pandas; print('  dpmm  ok')"
    "$STAGE/workers/eval/.venv/bin/python" -c "import numpy, scipy, sklearn; print('  eval  ok')"
fi

echo "==> packaging"
tar -C "$OUT" -czf "$STAGE.tar.gz" "$(basename "$STAGE")"
echo "bundle:    $STAGE.tar.gz"
echo "size:      $(du -h "$STAGE.tar.gz" | cut -f1) compressed, $(du -sh "$STAGE" | cut -f1) extracted"
echo "sha256:    $(sha256sum "$STAGE.tar.gz" | cut -d' ' -f1)"
